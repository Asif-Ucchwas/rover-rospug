  <version>0.1.0</version>
  <description>Gazebo Harmonic twin of the Cherry building floor with a Rover MEGA model (1100x770 mm)</description>
  <maintainer email="asifuzzamanucchwas@gmail.com">Md Asifuzzaman</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
