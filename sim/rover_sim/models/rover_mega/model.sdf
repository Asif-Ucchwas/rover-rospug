<?xml version="1.0"?>
<!-- Rover MEGA stand-in: 1.12 m x 0.81 m rectangular footprint (the real footprint), differential drive, 2D lidar.
     base_link sits at wheel-axle height (0.15 m). Dynamics (mass, speed limits) are placeholders until measured. -->
<sdf version="1.9">
  <model name="rover">
    <link name="base_link">
      <inertial><mass>60</mass><inertia><ixx>3.41</ixx><iyy>6.5</iyy><izz>9.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="chassis"><pose>0 0 0.10 0 0 0</pose><geometry><box><size>1.12 0.81 0.30</size></box></geometry></collision>
      <visual name="body"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>1.00 0.70 0.14</size></box></geometry><material><ambient>0.95 0.45 0.10 1</ambient><diffuse>0.95 0.45 0.10 1</diffuse></material></visual>
      <visual name="hood"><pose>0.38 0 0.21 0 0 0</pose><geometry><box><size>0.22 0.60 0.04</size></box></geometry><material><ambient>0.80 0.35 0.08 1</ambient><diffuse>0.80 0.35 0.08 1</diffuse></material></visual>
      <visual name="bumper_front"><pose>0.53 0 0.06 0 0 0</pose><geometry><box><size>0.05 0.66 0.08</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <visual name="bumper_rear"><pose>-0.53 0 0.06 0 0 0</pose><geometry><box><size>0.05 0.66 0.08</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material></visual>
      <visual name="snack_bin"><pose>-0.12 0 0.32 0 0 0</pose><geometry><box><size>0.58 0.56 0.26</size></box></geometry><material><ambient>0.78 0.60 0.38 1</ambient><diffuse>0.78 0.60 0.38 1</diffuse></material></visual>
      <visual name="bin_lid"><pose>-0.12 0 0.455 0 0 0</pose><geometry><box><size>0.60 0.58 0.03</size></box></geometry><material><ambient>0.62 0.46 0.28 1</ambient><diffuse>0.62 0.46 0.28 1</diffuse></material></visual>
      <visual name="bin_stripe"><pose>-0.12 0 0.32 0 0 0</pose><geometry><box><size>0.585 0.10 0.27</size></box></geometry><material><ambient>0.95 0.85 0.20 1</ambient><diffuse>0.95 0.85 0.20 1</diffuse></material></visual>
      <visual name="headlight_l"><pose>0.545 0.24 0.12 0 0 0</pose><geometry><box><size>0.02 0.12 0.05</size></box></geometry><material><ambient>1 1 0.85 1</ambient><diffuse>1 1 0.85 1</diffuse></material></visual>
      <visual name="headlight_r"><pose>0.545 -0.24 0.12 0 0 0</pose><geometry><box><size>0.02 0.12 0.05</size></box></geometry><material><ambient>1 1 0.85 1</ambient><diffuse>1 1 0.85 1</diffuse></material></visual>
      <visual name="taillight_l"><pose>-0.545 0.24 0.12 0 0 0</pose><geometry><box><size>0.02 0.12 0.05</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      <visual name="taillight_r"><pose>-0.545 -0.24 0.12 0 0 0</pose><geometry><box><size>0.02 0.12 0.05</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      <visual name="lidar_mast"><pose>0.48 0 0.37 0 0 0</pose><geometry><cylinder><radius>0.03</radius><length>0.36</length></cylinder></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      <visual name="lidar_head"><pose>0.48 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>0.08</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      <visual name="wheel_front_l"><pose>0.4 0.335 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="hub_front_l"><pose>0.4 0.375 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      <visual name="wheel_front_r"><pose>0.4 -0.335 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="hub_front_r"><pose>0.4 -0.375 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      <visual name="wheel_rear_l"><pose>-0.4 0.335 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="hub_rear_l"><pose>-0.4 0.375 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      <visual name="wheel_rear_r"><pose>-0.4 -0.335 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      <visual name="hub_rear_r"><pose>-0.4 -0.375 0 -1.5707963 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      <collision name="caster_front"><pose>0.45 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.10</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <collision name="caster_rear"><pose>-0.45 0 -0.05 0 0 0</pose><geometry><sphere><radius>0.10</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.48 0 0.55 0 0 0</pose><topic>/scan</topic><update_rate>10</update_rate><always_on>true</always_on>
        <gz_frame_id>base_link</gz_frame_id>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.1</min><max>20</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
      <sensor name="camera" type="camera">
        <pose>0.52 0 0.40 0 0 0</pose><topic>/camera/image_raw</topic><update_rate>15</update_rate><always_on>true</always_on>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
      </sensor>
      <sensor name="depth" type="depth_camera">
        <pose>0.52 0 0.40 0 0 0</pose><topic>/camera/depth</topic><update_rate>15</update_rate><always_on>true</always_on>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera><horizontal_fov>1.2</horizontal_fov><image><width>320</width><height>240</height><format>R_FLOAT32</format></image><clip><near>0.3</near><far>10</far></clip></camera>
      </sensor>
      <sensor name="imu" type="imu">
        <pose>0 0 0.10 0 0 0</pose><topic>/imu</topic><update_rate>100</update_rate><always_on>true</always_on>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.33 0 -1.5707963 0 0</pose>
      <inertial><mass>3</mass><inertia><ixx>0.0194</ixx><iyy>0.0194</iyy><izz>0.0338</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.33 0 -1.5707963 0 0</pose>
      <inertial><mass>3</mass><inertia><ixx>0.0194</ixx><iyy>0.0194</iyy><izz>0.0338</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="hub"><pose>0 0 -0.055 0 0 0</pose><geometry><cylinder><radius>0.07</radius><length>0.01</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute"><parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="right_wheel_joint" type="revolute"><parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.66</wheel_separation><wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>1.0</max_linear_velocity><min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity><min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>/joint_states</topic></plugin>
    <!-- ground truth: the physics engine's true pose of the rover (the diff-drive /odom only adds up wheel speed, so it reads 12 m even when the rover is stuck on a wall) -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame><odom_topic>/ground_truth</odom_topic>
      <tf_topic>/ground_truth_tf</tf_topic><odom_publish_frequency>30</odom_publish_frequency><dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
